<!DOCTYPE html>
<html lang="bn" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title>Blog Admin — Shifat</title>
<script>
try{var t=localStorage.getItem('shifat-theme');if(t)document.documentElement.dataset.theme=t;}catch(e){}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Roboto:wght@300;400&family=Roboto+Mono:wght@400&family=Noto+Serif+Bengali:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#151412; --surface:#1D1B18;
  --ink:#F1EEE6; --muted:rgba(241,238,230,.62); --faint:rgba(241,238,230,.38);
  --line:rgba(241,238,230,.14);
  --accent:#E2B45A; --accent-ink:#221A08;
  --f-head:"Poppins",sans-serif; --f-body:"Roboto",sans-serif;
  --f-bn:"Noto Serif Bengali",serif;
}
[data-theme="light"]{
  --bg:#F4F1E9; --surface:#FCFAF4;
  --ink:#1D1B17; --muted:rgba(29,27,23,.62); --faint:rgba(29,27,23,.4);
  --line:rgba(29,27,23,.15);
  --accent:#9A7118; --accent-ink:#fff;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--f-body);background:var(--bg);color:var(--ink);line-height:1.7}
::selection{background:var(--accent);color:var(--accent-ink)}
img{max-width:100%;display:block}
button{font-family:inherit;color:inherit}
.wrap{width:min(880px,100% - 2.4rem);margin-inline:auto}
.bar{position:sticky;top:0;z-index:10;background:rgba(21,20,18,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
[data-theme="light"] .bar{background:rgba(244,241,233,.9)}
.bar-in{display:flex;align-items:center;justify-content:space-between;padding:1rem 0}
.logo{font-family:var(--f-head);font-weight:600;text-decoration:none}
.logo .dot{color:var(--accent)}
.page{padding:2.5rem 0 6rem}
h1{font-family:var(--f-head);font-weight:600;font-size:1.7rem;letter-spacing:-.02em;margin-bottom:.4rem}
.sub{color:var(--muted);font-weight:300;font-size:.95rem;margin-bottom:2.4rem}
.card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:1.6rem;margin-bottom:1.6rem}
.card h2{font-family:var(--f-head);font-weight:600;font-size:1.05rem;margin-bottom:1.2rem;display:flex;align-items:center;gap:.6rem}
.card h2 .no{color:var(--accent);font-size:.8rem}
label{display:block;font-family:var(--f-bn);font-weight:500;font-size:.9rem;margin:1.1rem 0 .4rem}
input,textarea{width:100%;background:transparent;border:1px solid var(--line);border-radius:4px;padding:.75rem .9rem;font-family:var(--f-body);font-size:1rem;color:var(--ink);transition:border-color .3s}
textarea{min-height:260px;resize:vertical;font-family:var(--f-bn);font-size:1.05rem;line-height:1.9}
input:focus,textarea:focus{outline:none;border-color:var(--accent)}
.hint{color:var(--faint);font-size:.82rem;margin-top:.35rem;font-family:var(--f-bn)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.btn{display:inline-flex;align-items:center;gap:.55rem;background:var(--accent);color:var(--accent-ink);border:1px solid var(--accent);border-radius:4px;padding:.8rem 1.5rem;font-family:var(--f-head);font-weight:500;font-size:.95rem;cursor:pointer;transition:.3s;text-decoration:none}
.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}
.btn.ghost{background:none;color:var(--ink);border-color:var(--line)}
.btn.ghost:hover{border-color:var(--accent);color:var(--accent);filter:none}
.btn.sm{padding:.5rem 1rem;font-size:.85rem}
.btn.danger{background:none;border-color:var(--line);color:#e0705a}
.btn.danger:hover{border-color:#e0705a}
.btn-row{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.5rem}
.pitem{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
.pitem:last-child{border-bottom:none}
.pitem .t{font-family:var(--f-bn);font-weight:600}
.pitem .d{color:var(--faint);font-size:.8rem}
.pitem .acts{display:flex;gap:.5rem;flex:none}
.preview{margin-top:.7rem;border:1px solid var(--line);border-radius:4px;overflow:hidden;max-height:160px}
.preview img{width:100%;object-fit:cover}
.steps{list-style:none;counter-reset:s}
.steps li{counter-increment:s;display:flex;gap:.9rem;padding:.55rem 0;font-family:var(--f-bn);font-size:.95rem}
.steps li::before{content:counter(s);flex:none;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-family:var(--f-head);font-size:.78rem;font-weight:600;margin-top:.15rem}
.note{border:1px dashed var(--line);border-radius:4px;padding:1rem 1.2rem;color:var(--muted);font-size:.88rem;font-family:var(--f-bn);margin-top:1rem}
/* পাসওয়ার্ড গেট */
.gate{min-height:70vh;display:flex;align-items:center;justify-content:center}
.gate .card{max-width:380px;width:100%;text-align:center}
.gate input{text-align:center;margin:.6rem 0 1.2rem}
.toast-wrap{position:fixed;bottom:1.4rem;left:50%;transform:translateX(-50%);z-index:99}
.toast{background:var(--ink);color:var(--bg);padding:.8rem 1.4rem;border-radius:4px;font-family:var(--f-head);font-weight:500;font-size:.92rem;opacity:0;transform:translateY(12px);transition:.4s;box-shadow:0 10px 26px rgba(0,0,0,.3)}
.toast.show{opacity:1;transform:none}
@media(max-width:640px){.row{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<header class="bar">
  <div class="wrap bar-in">
    <a class="logo" href="index.html">Blog Admin<span class="dot">.</span></a>
    <a class="logo" href="blogs.html" style="font-size:.9rem;color:var(--muted)">সাইট দেখুন →</a>
  </div>
</header>

<!-- পাসওয়ার্ড গেট -->
<div class="wrap gate" id="gate">
  <div class="card">
    <h2 style="justify-content:center">🔒 Admin Panel</h2>
    <p style="color:var(--muted);font-family:var(--f-bn);font-size:.92rem">পাসওয়ার্ড দিন</p>
    <input type="password" id="passIn" placeholder="••••••••">
    <button class="btn" id="passBtn" style="width:100%;justify-content:center">ঢুকুন</button>
  </div>
</div>

<!-- মূল প্যানেল -->
<div class="wrap page" id="app" style="display:none">

  <h1>আপনার ব্লগ ম্যানেজার</h1>
  <p class="sub">লিখুন, সেভ করুন, ডাউনলোড করুন — তারপর GitHub-এ শুধু posts.js আপলোড। কোড ছোঁয়ার দরকার নেই।</p>

  <div class="card">
    <h2><span class="no">01</span> লেখা তৈরি / সম্পাদনা</h2>
    <label>শিরোনাম</label>
    <input id="fTitle" placeholder="লেখার শিরোনাম লিখুন">
    <div class="row">
      <div>
        <label>তারিখ</label>
        <input id="fDate" type="date">
      </div>
      <div>
        <label>কভার ছবি (লিংক)</label>
        <input id="fCover" placeholder="https://...jpg">
        <input id="fCoverFile" type="file" accept="image/*" style="margin-top:.5rem;font-size:.8rem">
      </div>
    </div>
    <div class="preview" id="coverPrev" style="display:none"><img id="coverImg" alt=""></div>
    <label>লেখা (প্যারার মাঝে একটা খালি লাইন দিন)</label>
    <textarea id="fBody" placeholder="আজকের চিন্তা…&#10;&#10;দ্বিতীয় প্যারা…"></textarea>
    <div class="btn-row">
      <button class="btn" id="saveBtn">✔ সেভ করুন</button>
      <button class="btn ghost" id="resetBtn">নতুন লেখা শুরু</button>
    </div>
    <p class="hint" id="editingNote"></p>
  </div>

  <div class="card">
    <h2><span class="no">02</span> সব লেখা (<span id="count">0</span>টা)</h2>
    <div id="plist"></div>
  </div>

  <div class="card">
    <h2><span class="no">03</span> প্রকাশ করুন</h2>
    <div class="btn-row" style="margin-top:0">
      <button class="btn" id="dlBtn">⬇ posts.js ডাউনলোড</button>
      <button class="btn ghost" id="copyBtn">📋 কপি করুন</button>
    </div>
    <ol class="steps" style="margin-top:1.4rem">
      <li>উপরের বাটনে চেপে <b>posts.js</b> ফাইলটা ডাউনলোড করুন</li>
      <li>GitHub → আপনার repository খুলুন</li>
      <li><b>Add file → Upload files</b> এ ক্লিক করুন</li>
      <li>ডাউনলোড করা <b>posts.js</b> টেনে ছেড়ে দিন (পুরনোটার জায়গায়)</li>
      <li><b>Commit changes</b> চাপুন — ১ মিনিটেই সাইটে লাইভ! 🎉</li>
    </ol>
    <div class="note">💡 কভার ছবির জন্য সবচেয়ে ভালো: ছবিটা আগে <b>postimages.org</b>-এর মতো ফ্রি হোস্টে আপলোড করে লিংক কপি করে "কভার ছবি (লিংক)" ঘরে বসান। সরাসরি ছবি আপলোড করলেও চলবে, তবে ফাইল বড় হলে সাইট একটু ভারী হবে।</div>
  </div>

</div>

<div class="toast-wrap" id="toastWrap"></div>

<script src="posts.js"></script>
<script>
"use strict";
/* ✏️ পাসওয়ার্ড বদলে নিন — এখানে (শুধু নিজের ব্রাউজার-প্রবেশ আটকায়, আসল নিরাপত্তা আপনার GitHub অ্যাকাউন্ট) */
var ADMIN_PASS = 'shifat2025';

var $ = function(s){ return document.querySelector(s); };
var LS_KEY = 'shifat-admin-posts';

/* ডেটা: localStorage > posts.js */
var posts;
try { posts = JSON.parse(localStorage.getItem(LS_KEY)) || null; } catch(e){ posts = null; }
if (!posts && typeof BLOG_POSTS !== 'undefined') posts = JSON.parse(JSON.stringify(BLOG_POSTS));
if (!posts) posts = [];
var editingSlug = null;

function toast(msg){
  var t = document.createElement('div');
  t.className = 'toast'; t.textContent = msg;
  $('#toastWrap').appendChild(t);
  requestAnimationFrame(function(){ t.classList.add('show'); });
  setTimeout(function(){ t.classList.remove('show'); setTimeout(function(){ t.remove(); }, 400); }, 3000);
}
function persist(){
  try{ localStorage.setItem(LS_KEY, JSON.stringify(posts)); }catch(e){}
}

/* গেট */
if (sessionStorage.getItem('shifat-admin-ok') === '1') unlock();
 $('#passBtn').addEventListener('click', tryPass);
 $('#passIn').addEventListener('keydown', function(e){ if (e.key === 'Enter') tryPass(); });
function tryPass(){
  if ($('#passIn').value === ADMIN_PASS){
    sessionStorage.setItem('shifat-admin-ok','1');
    unlock();
  } else toast('ভুল পাসওয়ার্ড!');
}
function unlock(){
  $('#gate').style.display = 'none';
  $('#app').style.display = 'block';
  $('#fDate').value = new Date().toISOString().slice(0,10);
  renderList();
}

/* ফর্ম */
 $('#fCoverFile').addEventListener('change', function(e){
  var f = e.target.files[0]; if (!f) return;
  if (f.size > 300*1024) toast('ছবিটা বড় ('+Math.round(f.size/1024)+'KB) — posts.js ভারী হবে');
  var r = new FileReader();
  r.onload = function(){ $('#fCover').value = r.result; showPreview(); };
  r.readAsDataURL(f);
});
 $('#fCover').addEventListener('input', showPreview);
function showPreview(){
  var v = $('#fCover').value.trim();
  if (v){ $('#coverImg').src = v; $('#coverPrev').style.display = 'block'; }
  else $('#coverPrev').style.display = 'none';
}
 $('#resetBtn').addEventListener('click', function(){
  editingSlug = null;
  $('#fTitle').value = ''; $('#fBody').value = ''; $('#fCover').value = '';
  $('#fDate').value = new Date().toISOString().slice(0,10);
  showPreview(); $('#editingNote').textContent = '';
});
 $('#saveBtn').addEventListener('click', function(){
  var title = $('#fTitle').value.trim();
  var body = $('#fBody').value;
  var date = $('#fDate').value || new Date().toISOString().slice(0,10);
  var cover = $('#fCover').value.trim();
  if (!title){ toast('শিরোনাম লিখুন!'); return; }
  if (editingSlug){
    for (var i=0;i<posts.length;i++){
      if (posts[i].slug === editingSlug){
        posts[i].title = title; posts[i].date = date; posts[i].body = body; posts[i].cover = cover;
        break;
      }
    }
    toast('আপডেট হয়েছে ✔');
  } else {
    var slug = date + '-' + Math.random().toString(36).slice(2,7);
    posts.push({ slug:slug, title:title, date:date, cover:cover, body:body });
    toast('নতুন লেখা সেভ হয়েছে ✔');
  }
  persist(); renderList(); $('#resetBtn').click();
});
function renderList(){
  $('#count').textContent = posts.length;
  var sorted = posts.slice().sort(function(a,b){ return b.date.localeCompare(a.date); });
  $('#plist').innerHTML = sorted.length ? sorted.map(function(p){
    return '<div class="pitem"><div><div class="t">' + p.title.replace(/</g,'&lt;') + '</div><div class="d">' + p.date + '</div></div>' +
      '<div class="acts"><button class="btn sm ghost" data-edit="' + p.slug + '">Edit</button>' +
      '<button class="btn sm danger" data-del="' + p.slug + '">Delete</button></div></div>';
  }).join('') : '<p style="color:var(--faint);font-family:var(--f-bn)">এখনো কোনো লেখা নেই। উপরে থেকে শুরু করুন।</p>';
}
document.addEventListener('click', function(e){
  var ed = e.target.closest('[data-edit]');
  if (ed){
    var s = ed.getAttribute('data-edit');
    for (var i=0;i<posts.length;i++){
      if (posts[i].slug === s){
        editingSlug = s;
        $('#fTitle').value = posts[i].title; $('#fDate').value = posts[i].date;
        $('#fBody').value = posts[i].body; $('#fCover').value = posts[i].cover || '';
        showPreview();
        $('#editingNote').textContent = '✏️ এখন সম্পাদনা হচ্ছে: ' + posts[i].title;
        scrollTo({ top:0, behavior:'smooth' });
        break;
      }
    }
  }
  var dl = e.target.closest('[data-del]');
  if (dl){
    var ds = dl.getAttribute('data-del');
    posts = posts.filter(function(p){ return p.slug !== ds; });
    persist(); renderList(); toast('মুছে ফেলা হয়েছে');
  }
});

/* এক্সপোর্ট */
function buildFile(){
  return '/* এই ফাইল admin.html থেকে তৈরি — হাতে এডিট করার দরকার নেই */\nvar BLOG_POSTS = ' + JSON.stringify(posts, null, 2) + ';\n';
}
 $('#dlBtn').addEventListener('click', function(){
  var blob = new Blob([buildFile()], { type:'text/javascript' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'posts.js';
  document.body.appendChild(a); a.click(); a.remove();
  toast('posts.js ডাউনলোড হয়েছে ✔');
});
 $('#copyBtn').addEventListener('click', function(){
  var txt = buildFile();
  function fb(){
    var ta = document.createElement('textarea');
    ta.value = txt; document.body.appendChild(ta); ta.select();
    try{ document.execCommand('copy'); toast('কপি হয়েছে — GitHub-এ posts.js এডিট করে পেস্ট করুন'); }
    catch(e){ toast('কপি করা গেল না'); }
    ta.remove();
  }
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(function(){ toast('কপি হয়েছে ✔'); }, fb);
  } else fb();
});
</script>
</body>
</html>